@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Vulkan)
find_dependency(stdexec CONFIG)
if(@VKEXEC_PACKAGE_NEEDS_VK_BOOTSTRAP@)
  find_dependency(vk-bootstrap CONFIG)
endif()

if(@vkexec_BUILD_VMA@)
  find_dependency(VulkanMemoryAllocator CONFIG)
endif()
if(@VKEXEC_PACKAGE_NEEDS_GLSLANG@)
  find_dependency(glslang CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/vkexecTargets.cmake")
check_required_components(vkexec)
